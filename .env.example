# Скопируйте в .env.local (локально) или задайте в Vercel -> Settings -> Environment Variables.
# Нужны только серверной версии сайта (Vercel или свой Node). На GitHub Pages сервера нет: форма открывает WhatsApp.
# Заявки уходят в Telegram через Bot API. Без этих переменных в production форма покажет запасной путь через WhatsApp.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный адрес сайта (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Аналитика: подключается только после согласия на cookies. Пусто = трекеры не грузятся.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
